//intuito do programa é contar a cardinalidade de um conjunto. (sem contar repetidos)
#include <iostream>
#include <vector>
#include <string>

int main()
{
    std::vector <std::string> itens = {"azul", "vermelho", "azul", "amarelo"};
    
    for (int i = 0 ; i < itens.size(); i++) {
                for (int j = i + 1; j < itens.size(); j++) {
                    if (itens[i] == itens[j]) {
                        std::cout << "Há um item repetido.";
            }
        }
    }


    return 0;
}
